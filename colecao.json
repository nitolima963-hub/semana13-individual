      "response": []
    },
    {
      "name": "03 - Criar um post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Título deve ser igual ao enviado\", function () {",
              "    pm.expect(pm.response.json().title).to.eql(\"Post do trio\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Post do trio\", \"body\": \"Teste de integração contínua\", \"userId\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "https://jsonplaceholder.typicode.com/posts",
