  "item": [
    {
      "name": "01 - Buscar usuário 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Usuário retornado deve ter ID 1\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://jsonplaceholder.typicode.com/users/1",
        "description": "Busca um usuário existente e confirma status e identificador."
      },
      "response": []
    },
    {
      "name": "02 - Buscar usuário inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "https://jsonplaceholder.typicode.com/users/999999",
        "description": "Verifica resposta quando o usuário não existe."
